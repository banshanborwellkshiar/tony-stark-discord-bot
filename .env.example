# ---------------------------------------------------------------------------
# Tony Stark Discord Bot — environment variables
# Copy this file to ".env" and fill in your real values.
# NEVER commit your real .env file (it is git-ignored).
# ---------------------------------------------------------------------------

# Discord bot token (Discord Developer Portal → Your App → Bot → Reset Token)
DISCORD_TOKEN=your-discord-bot-token-here

# n8n webhook URL that runs the AI Agent and returns { "reply": "..." }
N8N_WEBHOOK_URL=https://banshanborwellkshiar.app.n8n.cloud/webhook/discord-bot-webhook

# Discord application (client) ID — used for the invite link / logging (optional)
CLIENT_ID=your-discord-client-id-here

# ---------------------------------------------------------------------------
# Optional tuning (sensible defaults are used if omitted)
# ---------------------------------------------------------------------------

# How long to wait for n8n before giving up (milliseconds)
# WEBHOOK_TIMEOUT_MS=30000

# How many times to retry a failed webhook call
# WEBHOOK_MAX_RETRIES=3

# Base delay for exponential backoff between retries (milliseconds)
# WEBHOOK_RETRY_BASE_MS=800

# Per-user rate limit: max messages per window
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=15000

# Set to "true" for verbose debug logging
# DEBUG=false

# ---------------------------------------------------------------------------
# RAG / Khasi knowledge base (optional — leave blank to disable RAG)
# ---------------------------------------------------------------------------

# Supabase project (Settings -> API)
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-anon-public-key        # used by the bot at query time
# SUPABASE_SERVICE_KEY=your-service-role-key     # used by ingest.js only (keep secret)

# Gemini API key — reused for free text-embedding-004 embeddings
# GEMINI_API_KEY=your-gemini-api-key
